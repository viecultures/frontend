# Link cập nhập .env (đã khóa truy cập, chỉ có team): 
# https://drive.google.com/drive/folders/1q00f_8FjpV_3D1JZvzky_t77R6eZ7GRB?hl=vi

# Frontend Development Server Port
VITE_PORT=5174

# Backend API Configuration
VITE_BACKEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth Client ID for Web Sign-In
VITE_GOOGLE_CLIENT_ID=

# Temporary browser-only login (local). Set backend to restore backend authentication.
VITE_AUTH_MODE=local

# Show a browser-only demo account in a closed-test build (development and local mode show it automatically).
VITE_ENABLE_DEMO_LOGIN=false

# Map AI Diagnostics & Simulator (set to true in dev to enable live HUD, set to false in prod)
VITE_MAP_AI_DEBUG=

# Cloudflare R2 Public Media Storage
VITE_R2_PUBLIC_URL=https://pub-b59d6caa40b24474b79648789b6c72c9.r2.dev
